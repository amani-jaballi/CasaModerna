        <ui:TextField picking-mode="Ignore" label="Email :       " password="false" readonly="false" is-delayed="false" hide-mobile-input="false" multiline="false" name="ForgotEmailField" style="height: 145px; width: 600px; font-size: 30px; -unity-font-style: bold; flex-direction: column; align-self: center; margin-top: 50px; margin-bottom: 50px; -unity-font: url(&quot;project://database/Assets/Fonts/DMSerifText-Regular.ttf?fileID=12800000&amp;guid=78a8d4446ca48ec42896e024ad998da9&amp;type=3#DMSerifText-Regular&quot;); color: rgb(78, 54, 39); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-font-definition: initial;" />
        <ui:Button text="Reset" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResetPasswordButton" style="align-self: center; align-items: flex-end; justify-content: center; -unity-text-align: middle-center; margin-top: 2px; background-color: rgb(176, 140, 115); width: 300px; height: 100px; font-size: 30px; -unity-font-style: bold; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; margin-bottom: 4px; -unity-font: url(&quot;project://database/Assets/Fonts/Limelight-Regular.ttf?fileID=12800000&amp;guid=9d13400ec2ddbe0409e402246a571086&amp;type=3#Limelight-Regular&quot;); bottom: 0; -unity-font-definition: initial; top: 0;" />
        <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MessageLabel" style="-unity-text-align: upper-center; font-size: 25px; -unity-font-style: bold; -unity-font: url(&quot;project://database/Assets/Fonts/DMSerifText-Regular.ttf?fileID=12800000&amp;guid=78a8d4446ca48ec42896e024ad998da9&amp;type=3#DMSerifText-Regular&quot;); color: rgb(57, 35, 22); bottom: 0; visibility: visible; top: 0; -unity-font-definition: initial;" />
        <ui:Label tabindex="-1" text="If you don&apos;t receive an email within 5 minutes, please check your network or try again." parse-escape-sequences="true" display-tooltip-when-elided="true" style="top: 100px; align-self: center; -unity-font-style: bold; font-size: 25px; -unity-text-align: upper-center; white-space: normal; -unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/Fonts/DMSerifText-Regular.ttf?fileID=12800000&amp;guid=78a8d4446ca48ec42896e024ad998da9&amp;type=3#DMSerifText-Regular&quot;); width: 521px; justify-content: flex-end; flex-wrap: nowrap; flex-direction: column;" />
        <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" style="background-image: url(&quot;project://database/Assets/Sprites/Icons/danger.png?fileID=2800000&amp;guid=a9ed9135883cd62479ae1c20536aa104&amp;type=3#danger&quot;); -unity-background-scale-mode: scale-to-fit; height: 70px; width: 100px; rotate: 0; bottom: 0;" />
