<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Label text="Shopping Cart" name="CartTitle" style="-unity-text-align: upper-center; -unity-font-style: bold; -unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/Fonts/Limelight-Regular.ttf?fileID=12800000&amp;guid=9d13400ec2ddbe0409e402246a571086&amp;type=3#Limelight-Regular&quot;); font-size: 40px; color: rgb(82, 58, 46); top: 100px; width: 428px; align-self: center;" />
    <ui:VisualElement name="Cart" style="background-color: rgb(255, 248, 240); align-self: center; width: 1200px; left: 0; right: 100px; justify-content: center; margin-top: 200px; height: 700px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; bottom: 90px;">
        <ui:VisualElement name="CartRoot">
            <ui:VisualElement name="CartItems">
                <ui:VisualElement name="CartItem" style="height: 368px; top: -30px;">
                    <ui:Button text="X" name="RemoveButton" style="background-color: rgb(124, 93, 78); white-space: nowrap; align-self: flex-end; top: 50px; font-size: 20px; right: 399px; width: 92px; -unity-font-style: bold;" />
                    <ui:Image name="ProductImage" />
                    <ui:Label text="  Product Name:" name="ProductName" style="height: 35px; width: 518px; font-size: 30px; -unity-font-style: bold; -unity-font: url(&quot;project://database/Assets/SharedAssets/TextMeshPro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-definition: initial; -unity-text-align: upper-left; color: rgb(66, 43, 31); background-color: rgba(224, 221, 203, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(56, 56, 56, 0); border-right-color: rgba(56, 56, 56, 0); border-top-color: rgba(56, 56, 56, 0); border-bottom-color: rgba(56, 56, 56, 0); align-self: flex-start;" />
                    <ui:Label text="  Price:" name="ProductPrice" style="height: 43px; width: 361px; font-size: 30px; -unity-font-style: bold; -unity-font: url(&quot;project://database/Assets/SharedAssets/TextMeshPro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-definition: initial; -unity-text-align: upper-left; color: rgb(67, 44, 32);" />
                    <ui:Label tabindex="-1" text="  Quantity:" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ProductQte" style="height: 37px; width: 153px; top: 90px; font-size: 30px; -unity-font-style: bold; -unity-font: url(&quot;project://database/Assets/SharedAssets/TextMeshPro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-definition: initial; -unity-text-align: upper-left; color: rgb(67, 44, 32);" />
                    <ui:VisualElement name="QuantityContainer" style="align-self: center;">
                        <ui:Button text="-" name="DecreaseQty" style="background-color: rgb(125, 93, 79); width: 88px; font-size: 35px; -unity-font-style: bold;" />
                        <ui:Label text="1" name="QuantityValue" style="font-size: 30px; -unity-font-style: bold;" />
                        <ui:Button text="+" name="IncreaseQty" style="background-color: rgb(125, 93, 79); font-size: 35px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="CartSummary" style="height: 200px;">
                <ui:Label text="  Subtotal: 0 dt" name="SubtotalText" style="height: 32px; width: 339px; font-size: 30px; -unity-font-style: bold; -unity-font: url(&quot;project://database/Assets/SharedAssets/TextMeshPro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-definition: initial; -unity-text-align: upper-left; color: rgb(67, 44, 32);" />
                <ui:Label text="  Shipping: -" name="ShippingText" style="width: 353px; font-size: 30px; -unity-font-style: bold; -unity-font: url(&quot;project://database/Assets/SharedAssets/TextMeshPro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-definition: initial; -unity-text-align: upper-left; color: rgb(67, 44, 32);" />
                <ui:Label text="  Total: 0 dt" name="TotalText" style="width: 303px; font-size: 30px; -unity-font-style: bold; -unity-font: url(&quot;project://database/Assets/SharedAssets/TextMeshPro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-definition: initial; -unity-text-align: upper-left; color: rgb(67, 44, 32);" />
                <ui:Button text="Confirm Order" name="ConfirmButton" style="background-color: rgb(125, 93, 79); font-size: 35px; -unity-font-style: bold; color: rgb(207, 204, 193); width: 360px; align-self: center; height: 70px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; -unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/SharedAssets/TextMeshPro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); top: 30px;" />
                <ui:Button text="Go back" parse-escape-sequences="true" display-tooltip-when-elided="true" name="GoBackButton" style="align-self: center; font-size: 35px; -unity-font-style: bold; background-color: rgb(125, 93, 79); color: rgb(207, 204, 193); -unity-font: url(&quot;project://database/Assets/SharedAssets/TextMeshPro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-definition: initial; width: 180px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; height: 70px; bottom: 45px; left: 300px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
